{
  "annotations": { "list": [] },
  "description": "Diag-Bifrost-03 (2026-05-18): synthetic 60s ping of Bifrost /v1/chat/completions route. Sampler daemon in legion-backend populates the histogram. Pair with alert rules BifrostRouteLatencyHigh (warning, p95>5s/5min) and BifrostRouteAllFailing (critical, <50% success/5min).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "legion-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "red",    "value": 5 }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(legion_bifrost_route_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "title": "Bifrost route p95 latency (5m)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "legion-prometheus" },
