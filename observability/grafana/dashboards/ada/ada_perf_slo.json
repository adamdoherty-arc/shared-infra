{
  "annotations": {"list": []},
  "description": "Per-route latency SLO dashboard. Compares live p95/p99 per path_template to budgets from backend/config/slo.yaml. Overlay thresholds set to the tightest common budget (500ms/2s/8s); consult the SLO manifest for per-route budgets. Wired to ada_http_request_duration_seconds_v2 (method, path_template, status_code labels).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "SLO Manifest (JSON)",
      "url": "http://localhost:8006/api/system/slo",
      "type": "link",
      "targetBlank": true
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "type": "timeseries",
      "title": "p95 latency by route (top 15)",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "P1809F7CD0C7575DA"},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 5},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 2},
              {"color": "red", "value": 8}
            ]
          }
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["max", "mean"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "topk(15, histogram_quantile(0.95, sum by (path_template, le) (rate(ada_http_request_duration_seconds_v2_bucket{path_template!=\"/metrics\",path_template!=\"/api/health/cached\"}[5m]))))",
          "legendFormat": "{{path_template}}",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 latency by route — 5xx only",
      "gridPos": {"h": 10, "w": 12, "x": 0, "y": 10},
      "datasource": {"type": "prometheus", "uid": "P1809F7CD0C7575DA"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "topk(10, histogram_quantile(0.95, sum by (path_template, le) (rate(ada_http_request_duration_seconds_v2_bucket{status_code=~\"5..\"}[10m]))))",
          "legendFormat": "{{path_template}} 5xx",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request rate by route (top 10)",
      "gridPos": {"h": 10, "w": 12, "x": 12, "y": 10},
      "datasource": {"type": "prometheus", "uid": "P1809F7CD0C7575DA"},
      "fieldConfig": {"defaults": {"unit": "reqps"}},
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "topk(10, sum by (path_template) (rate(ada_http_request_duration_seconds_v2_count[5m])))",
          "legendFormat": "{{path_template}}",
          "range": true
        }
      ]
    },
    {
      "type": "table",
      "title": "Live p95 vs SLO budget (evaluated last 15m)",
      "gridPos": {"h": 14, "w": 24, "x": 0, "y": 20},
      "description": "One row per path_template. `p95_ms_live` is the observed p95 across the last 15m; consult /api/system/slo for the per-route budget.",
      "datasource": {"type": "prometheus", "uid": "P1809F7CD0C7575DA"},
      "targets": [
        {
          "refId": "P95",
          "editorMode": "code",
          "expr": "1000 * histogram_quantile(0.95, sum by (path_template, le) (rate(ada_http_request_duration_seconds_v2_bucket[15m])))",
          "legendFormat": "{{path_template}}",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "P99",
          "editorMode": "code",
          "expr": "1000 * histogram_quantile(0.99, sum by (path_template, le) (rate(ada_http_request_duration_seconds_v2_bucket[15m])))",
          "legendFormat": "{{path_template}}",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "RPM",
          "editorMode": "code",
          "expr": "60 * sum by (path_template) (rate(ada_http_request_duration_seconds_v2_count[15m]))",
          "legendFormat": "{{path_template}}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {"byField": "path_template", "mode": "outer"}
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value #P95": "p95_ms_live",
              "Value #P99": "p99_ms_live",
              "Value #RPM": "req_per_min"
            },
            "indexByName": {
              "path_template": 0,
              "p95_ms_live": 1,
              "p99_ms_live": 2,
              "req_per_min": 3
            }
          }
        }
      ]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["ada", "performance", "slo"],
  "templating": {"list": []},
  "time": {"from": "now-30m", "to": "now"},
  "timezone": "",
  "title": "ADA Per-Route SLO",
  "uid": "ada-perf-slo",
  "version": 1,
  "weekStart": ""
}
