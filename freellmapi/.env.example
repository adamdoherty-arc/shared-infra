# shared-freellmapi environment template
# Copy to c:\code\shared-infra\.env (alongside the existing Bifrost vars) or
# leave variable lookups against the root .env file.
#
# Generate a fresh ENCRYPTION_KEY (used to AES-256-GCM-encrypt provider keys
# inside SQLite):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Treat this value like a database master password — losing it makes every
# stored provider API key unrecoverable; rotating it requires wiping the DB.
FREELLMAPI_ENCRYPTION_KEY=

# Host port mapping (container always listens on 3001 internally).
FREELLMAPI_HOST_PORT=3001

# Optional: pin a different upstream commit for the next image build.
# Default is set in the Dockerfile ARG block.
# FREELLMAPI_COMMIT=18eb04be990bcdaca842574bf6e00a6968308761
