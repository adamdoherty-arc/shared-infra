# NSSM rotated logs — explosively numerous during a crash loop.
# The current nssm-stdout.log / nssm-stderr.log files are kept (not patterned).
nssm-stderr-*.log
nssm-stdout-*.log

# .env carries provider API keys
.env
!.env.example
# Also exclude timestamped .env snapshots so pre-swap backup files
# don't leak the API keys the base .env is redacting.
.env.bak.*
.env.bak-*

# Ad-hoc timestamped compose backups (docker-compose.*.bak.* /
# docker-compose.*.bak-*) taken before risky swaps. Track the live
# file only.
docker-compose.*.bak.*
docker-compose.*.bak-*

# Migration archives (bifrost migration 2026-05-14)
.deleted-2026-05-14/

# Bifrost runtime SQLite. The request-log DB is huge (tens of GB) and the
# -wal/-shm sidecars are transient. config.db (the VK/provider mirror) IS
# tracked intentionally; its wal/shm sidecars are not.
bifrost/logs.db
bifrost/logs.db-wal
bifrost/logs.db-shm
bifrost/config.db-wal
bifrost/config.db-shm

# Ad-hoc config backups. Widened 2026-08-11 from `bifrost/*.bak.*` to `*.bak*`
# so it also catches the trailing-suffix and infix variants actually produced by
# swap runs: config.json.pre-101261-ws7-<ts>.bak, vllm-local.provider.bak-<ts>.json.
# These MUST stay on disk (they are the documented rollback path) but must not be
# committed — untracked backup clutter is how the live Pass-6 model swap sat in
# `git status` unnoticed for a day. Root-level compose/.env variants are already
# covered by the dedicated patterns near the top of this file.
bifrost/*.bak*
bifrost/*.pre-*.bak

# Archived corrupt DBs set aside for possible later recovery (logs.db.corrupt-*)
bifrost/*.corrupt-*
# 2026-07-13 (Perf-503b Wave 3b W4): a concurrent archive-and-recreate run used
# a bifrost/archive/ subdirectory instead of the flat bifrost/*.corrupt-<date>
# convention above — that pattern is NOT recursive, so bifrost/archive/ was
# untracked-but-NOT-ignored (git status showed it as a stageable 20+ GB
# directory). Cover both conventions.
bifrost/archive/

# Python bytecode
__pycache__/
*.pyc

# autoheal runtime alert trail (written by bifrost-autoheal)
bifrost/autoheal.log
