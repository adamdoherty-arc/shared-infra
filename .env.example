# shared-infra environment
# Copy to .env and fill in provider keys. Every project (Zero, ADA, Legion) talks
# to LiteLLM at host.docker.internal:4444 — they never see provider keys directly.

# LiteLLM master key — projects authenticate with this when hitting :4444.
# Generate once: openssl rand -hex 24
LITELLM_MASTER_KEY=sk-shared-master-change-me

# Provider API keys
KIMI_API_KEY=
MINIMAX_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Local endpoints (for reference; configured in bifrost/config.json)
# qwen38-chat:18020 (host 18801) — Qwen3.8-27B W4A16 syv-ai stack (served as qwen3.8-27b; legacy aliases incl. qwen3-chat remapped in Bifrost)
# vllm-embed:8001   — Qwen3-Embedding-0.6B
